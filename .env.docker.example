# Domain Configuration
DOMAIN=yourdomain.com

# ACME (Let's Encrypt)
ACME_EMAIL=admin@yourdomain.com

# Traefik Dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=$$2y$$05$$your_bcrypt_hash_here

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=avtoplaneta
# Shared database fallback:
DATABASE_URL=postgres://postgres:your_secure_password@postgres:5432/avtoplaneta?sslmode=disable
# Optional isolated databases per microservice (Database-per-Service):
# AUTH_DATABASE_URL=postgres://postgres:your_secure_password@postgres:5432/avtoplaneta_auth?sslmode=disable
# PARTS_DATABASE_URL=postgres://postgres:your_secure_password@postgres:5432/avtoplaneta_parts?sslmode=disable
# ORDERS_DATABASE_URL=postgres://postgres:your_secure_password@postgres:5432/avtoplaneta_orders?sslmode=disable
# MESSAGING_DATABASE_URL=postgres://postgres:your_secure_password@postgres:5432/avtoplaneta_messaging?sslmode=disable

# Session
SESSION_SECRET=your_session_secret_at_least_32_characters

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OpenRouter API
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# Drom API
DROM_API_KEY=your_drom_api_key
DROM_PACKET_ID=your_packet_id

# Redis
REDIS_URL=redis:6379

# Forwarded IPs (for Traefik)
FORWARDED_ALLOW_IPS=*

# Alertmanager: Оповещения в Telegram и Email (только технические сбои, без бизнес-метрик)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_SMARTHOST=smtp.gmail.com:587
ALERT_EMAIL_AUTH_USERNAME=
ALERT_EMAIL_AUTH_PASSWORD=
