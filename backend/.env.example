# ==============================================================================
# Шаблон переменных окружения для локальной разработки бэкенда (backend/.env.example)
# cp backend/.env.example backend/.env
# ==============================================================================

# Database Configuration
DATABASE_URL=postgres://postgres:your_password@localhost:5432/avtoplaneta?sslmode=disable

# Session & JWT Configuration (генерировать случайную строку от 32 символов)
SESSION_SECRET=change_this_to_a_secure_random_key_min_32_chars
JWT_SECRET=change_this_to_a_secure_random_key_min_32_chars

# Первоначальный администратор системы (при инициализации чистой БД)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change_this_initial_admin_password

# OpenRouter API Configuration
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Environment
NODE_ENV=development

# Drom API Configuration
DROM_API_KEY=your_drom_api_key_here
DROM_PACKET_ID=your_packet_id_here
