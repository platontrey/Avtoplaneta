# ==============================================================================
# Шаблон переменных окружения для проекта Avtoplaneta (.env.example)
# Скопируйте этот файл в .env и укажите ваши реальные значения:
# cp .env.example .env
# ==============================================================================

# Домен и сетевые настройки
DOMAIN=yourdomain.com
PUBLIC_DOMAIN=yourdomain.com
SERVER_IP=127.0.0.1
NODE_ENV=production

# ACME (Let's Encrypt SSL)
ACME_EMAIL=admin@yourdomain.com

# Traefik Dashboard (Basic Auth)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=$$2y$$05$$your_bcrypt_hash_here

# PostgreSQL База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=avtoplaneta
# Общая строка подключения (fallback):
DATABASE_URL=postgres://postgres:your_secure_password_here@postgres:5432/avtoplaneta?sslmode=disable
# Изолированные базы данных для каждого микросервиса (Database-per-Service):
# AUTH_DATABASE_URL=postgres://postgres:your_secure_password_here@postgres:5432/avtoplaneta_auth?sslmode=disable
# PARTS_DATABASE_URL=postgres://postgres:your_secure_password_here@postgres:5432/avtoplaneta_parts?sslmode=disable
# ORDERS_DATABASE_URL=postgres://postgres:your_secure_password_here@postgres:5432/avtoplaneta_orders?sslmode=disable
# MESSAGING_DATABASE_URL=postgres://postgres:your_secure_password_here@postgres:5432/avtoplaneta_messaging?sslmode=disable

# Безопасность сессий и JWT токенов (минимум 32 случайных символа: openssl rand -hex 32)
SESSION_SECRET=generate_with_openssl_rand_hex_32
JWT_SECRET=generate_with_openssl_rand_hex_32

# Первоначальный администратор системы (используется при первом запуске пустой БД)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=generate_initial_strong_admin_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OpenRouter API (AI помощник)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# Drom.ru Интеграция
DROM_API_KEY=your_drom_api_key
DROM_PACKET_ID=your_packet_id
DROM_LOGIN=your_drom_phone_number
DROM_PASSWORD=your_drom_password

# Redis
REDIS_URL=redis:6379
REDIS_PASSWORD=

# Grafana Мониторинг
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password

# Forwarded IPs (для Traefik)
FORWARDED_ALLOW_IPS=*
