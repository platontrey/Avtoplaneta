<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Minimalist Dark Theme -->
    <style name="Base.Theme.AvtoplanetaApp" parent="Theme.Material3.Dark.NoActionBar">
        
        <!-- Dark Color Scheme -->
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorPrimaryDark">#2563EB</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#A78BFA</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">#1E293B</item>
        <item name="colorOnSurface">#F8FAFC</item>
        <item name="colorSurfaceVariant">#1E293B</item>
        <item name="colorOnSurfaceVariant">#CBD5E1</item>
        
        <!-- Background -->
        <item name="android:colorBackground">#0F172A</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="android:textColorHint">#64748B</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>

    <style name="Theme.AvtoplanetaApp" parent="Base.Theme.AvtoplanetaApp" />
    
    <!-- Dark Card Style -->
    <style name="AppCard">
        <item name="cardBackgroundColor">#1E293B</item>
        <item name="cardElevation">@dimen/elevation_small</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="contentPadding">@dimen/padding_medium</item>
        <item name="strokeWidth">0dp</item>
    </style>
    
    <!-- Dark Card Elevated -->
    <style name="AppCard.Elevated">
        <item name="cardElevation">@dimen/elevation_medium</item>
        <item name="cardBackgroundColor">#1E293B</item>
    </style>
    
    <!-- Dark Text Input Style -->
    <style name="AppTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="boxStrokeColor">#475569</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">#1E293B</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>
    
    <!-- Dark Button Style -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#3B82F6</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>

    <!-- Dark Outlined Button -->
    <style name="AppButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#475569</item>
        <item name="android:textColor">#3B82F6</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>
</resources>
