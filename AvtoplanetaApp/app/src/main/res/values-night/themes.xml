<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Theme matching website -->
    <style name="Base.Theme.AvtoplanetaApp" parent="Theme.Material3.Dark.NoActionBar">

        <!-- Dark Color Scheme -->
        <item name="colorPrimary">#EBEBEB</item>
        <item name="colorPrimaryDark">#343434</item>
        <item name="colorOnPrimary">#343434</item>
        <item name="colorSecondary">#454545</item>
        <item name="colorOnSecondary">#FCFCFC</item>
        <item name="colorSurface">#404040</item>
        <item name="colorOnSurface">#FCFCFC</item>
        <item name="colorSurfaceVariant">#454545</item>
        <item name="colorOnSurfaceVariant">#8E8E8E</item>

        <!-- Background -->
        <item name="android:colorBackground">#1E1E1E</item>
        <item name="android:textColorPrimary">#FCFCFC</item>
        <item name="android:textColorSecondary">#8E8E8E</item>
        <item name="android:textColorHint">#8E8E8E</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>

    <style name="Theme.AvtoplanetaApp" parent="Base.Theme.AvtoplanetaApp" />

    <!-- Dark Card Style -->
    <style name="AppCard">
        <item name="cardBackgroundColor">#404040</item>
        <item name="cardElevation">@dimen/elevation_small</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="contentPadding">@dimen/padding_medium</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Dark Card Elevated -->
    <style name="AppCard.Elevated">
        <item name="cardElevation">@dimen/elevation_medium</item>
        <item name="cardBackgroundColor">#404040</item>
    </style>

    <!-- Dark Text Input Style -->
    <style name="AppTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">#8E8E8E</item>
        <item name="boxStrokeColor">#FFFFFF1A</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">#404040</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>

    <!-- Dark Button Style -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="android:textColor">#343434</item>
        <item name="android:backgroundTint">#EBEBEB</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>

    <!-- Dark Outlined Button -->
    <style name="AppButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#FFFFFF1A</item>
        <item name="android:textColor">#EBEBEB</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>
</resources>
