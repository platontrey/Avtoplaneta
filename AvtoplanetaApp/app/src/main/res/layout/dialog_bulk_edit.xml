<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Массовое редактирование"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etBulkCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Категория"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etBulkBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Бренд"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etBulkModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Модель"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etBulkLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Местоположение"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etBulkPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Цена"
        android:inputType="numberDecimal"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etBulkQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Количество"
        android:inputType="number"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etBulkDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Описание"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBulkEditCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Отмена"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnBulkEditApply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Применить"
            android:background="@drawable/rounded_button_blue" />

    </LinearLayout>

</LinearLayout>